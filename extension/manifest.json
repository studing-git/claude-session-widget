{
  "manifest_version": 3,
  "name": "AI 사용량 위젯 브리지",
  "version": "2.0.0",
  "description": "로그인된 브라우저에서 Claude·ChatGPT·Gemini 사용량을 읽어 데스크탑 위젯으로 전달합니다.",
  "permissions": ["alarms", "tabs"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/settings/usage*"],
      "js": ["providers/claude.js", "content-collect.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["providers/chatgpt.js", "content-collect.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/usage*"],
      "js": ["providers/gemini.js", "content-collect.js"],
      "run_at": "document_idle"
    }
  ]
}
